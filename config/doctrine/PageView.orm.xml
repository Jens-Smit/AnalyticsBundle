<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Jenssmit\AnalyticsBundle\Entity\PageView" table="jenssmit_page_view">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="siteKey" length="32"/>
        <field name="path" length="500"/>
        <field name="createdAt" type="datetime_immutable"/>
        <field name="route" length="190" nullable="true"/>
        <field name="referrer" length="255" nullable="true"/>
        <field name="browser" length="32" nullable="true"/>
        <field name="operatingSystem" length="32" nullable="true"/>
        <field name="device" length="16" nullable="true"/>
        <field name="ipHash" length="64" nullable="true"/>
        <field name="userIdentifier" length="191" nullable="true"/>
    </entity>
</doctrine-mapping>
