<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="https://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Jenssmit\AnalyticsBundle\Entity\PageView" table="jenssmit_page_view">
        <id name="id" type="integer">
            <generator strategy="IDENTITY"/>
        </id>

        <field name="siteKey" column="site_key" type="string" length="32"/>
        <field name="path" type="string" length="500"/>
        <field name="route" type="string" length="190" nullable="true"/>
        <field name="referrer" type="string" length="500" nullable="true"/>
        <field name="userAgent" column="user_agent" type="string" length="255" nullable="true"/>
        <field name="browser" type="string" length="32" nullable="true"/>
        <field name="operatingSystem" column="operating_system" type="string" length="32" nullable="true"/>
        <field name="device" type="string" length="16" nullable="true"/>
        <field name="ipHash" column="ip_hash" type="string" length="64" nullable="true"/>
        <field name="userIdentifier" column="user_identifier" type="string" length="191" nullable="true"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>

        <indexes>
            <index name="idx_jenssmit_page_view_created_at" columns="created_at"/>
            <index name="idx_jenssmit_page_view_site_created" columns="site_key,created_at"/>
        </indexes>
    </entity>

</doctrine-mapping>
