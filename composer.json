{
    "name": "jenssmit/analytics-bundle",
    "description": "Cookiefreies Web-Analytics-Bundle für Symfony mit Mandantentrennung und datensparsamer Erfassung",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Jens Smit",
            "homepage": "https://jenssmit.de"
        }
    ],
    "require": {
        "php": ">=8.2",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^2.13 || ^3.0",
        "doctrine/orm": "^3.0",
        "psr/cache": "^3.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/lock": "^6.4 || ^7.0 || ^8.0",
        "symfony/messenger": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-bundle": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.28",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5",
        "symfony/phpunit-bridge": "^6.4 || ^7.0 || ^8.0",
        "symfony/var-exporter": "^6.4 || ^7.0 || ^8.0"
    },
    "suggest": {
        "symfony/messenger": "Für asynchrones Recording (RecordPageViewMessage); synchroner Modus bleibt Standard."
    },
    "autoload": {
        "psr-4": {
            "Jenssmit\\AnalyticsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jenssmit\\AnalyticsBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "stan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "require": "^6.4 || ^7.0 || ^8.0",
            "allow-contrib": false
        }
    }
}
