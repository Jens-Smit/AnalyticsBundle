{
    "name": "jenssmit/analytics-bundle",
    "type": "symfony-bundle",
    "description": "Cookiefreie, DSGVO-orientierte Seitenaufruf-Statistik für Symfony: Erfassung per Endpunkt oder serverseitig, Auswertungs-API für Dashboards.",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/orm": "^3.0",
        "symfony/console": "^7.0",
        "symfony/framework-bundle": "^7.0",
        "symfony/security-bundle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "symfony/phpunit-bridge": "^7.0"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Jenssmit\\AnalyticsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jenssmit\\AnalyticsBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "require": "^7.0"
        }
    }
}
